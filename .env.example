# Copiar a .env (NUNCA commitear .env).

# Cualquier Postgres con PostGIS. Este es el del Supabase CLI local.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# JWKS del proveedor de auth (tokens ES256: default del Supabase CLI actual).
JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# API de auth que usa /v1/auth/* (el cliente no habla con el proveedor). La api key es
# la ANON_KEY / PUBLISHABLE_KEY de `supabase status` (`make up` la completa en .env).
AUTH_URL=http://127.0.0.1:54321/auth/v1
AUTH_API_KEY=

# Alternativa para tokens HS256: secreto con el que el proveedor de auth firma los JWT.
# En local, `supabase status` lo muestra como "JWT secret". En prod: secret de la plataforma.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_AUDIENCE=authenticated

# Orígenes web que pueden llamar a la API (CORS), separados por coma: el panel de admin.
# Si abrís el panel desde otra máquina (http://192.168.1.50:8080), agregá ese origen.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

LOG_LEVEL=INFO

# OAuth (cableado listo, NO activado en v0.0.1)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
