# Copiar a .env (NUNCA commitear .env).

# Cualquier Postgres con PostGIS. Este es el del Supabase CLI local.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# JWKS del proveedor de auth (tokens ES256: default del Supabase CLI actual).
JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# API de auth que usa /v1/auth/* (el cliente no habla con el proveedor). La api key es
# la ANON_KEY / PUBLISHABLE_KEY de `supabase status` (`make up` la completa en .env).
AUTH_URL=http://127.0.0.1:54321/auth/v1
AUTH_API_KEY=

# Alternativa para tokens HS256: secreto con el que el proveedor de auth firma los JWT.
# En local, `supabase status` lo muestra como "JWT secret". En prod: secret de la plataforma.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_AUDIENCE=authenticated

# Orígenes web que pueden llamar a la API (CORS), separados por coma: el panel de admin.
# Si abrís el panel desde otra máquina (http://192.168.1.50:8080), agregá ese origen.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

LOG_LEVEL=INFO

# Proxies confiables delante del backend (0 = ninguno). Con N > 0 el rate limit por IP toma
# la N-ésima IP desde la derecha de X-Forwarded-For. Ver docs/04, §6.
PROXY_HOPS=0

# OAuth (cableado listo, NO activado en v0.0.1)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Carpeta donde los ETL escriben sus exports (los forms piden solo el nombre del archivo).
# ETL_EXPORT_DIR=etl/data/exports

# Almacén de exportaciones (docs/04 §11.4): dónde queda lo que el sistema exporta solo (eventos).
# Sin EXPORT_S3_ENDPOINT se usa el disco (ETL_EXPORT_DIR). `make up` completa estas variables con
# el Storage local de Supabase; en producción, las del bucket real (Supabase Storage u otro S3).
# Probalo con `make almacen-probar`. Para el S3 alternativo (SeaweedFS): `make s3-alt-up` y las variables de abajo.
# EXPORT_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
# EXPORT_S3_ENDPOINT_DOCKER=http://host.docker.internal:54321/storage/v1/s3   # solo el backend en docker
# EXPORT_S3_BUCKET=exportaciones
# EXPORT_S3_KEY=
# EXPORT_S3_SECRET=
# EXPORT_S3_REGION=local
# S3 alt.: ENDPOINT=http://127.0.0.1:8333 (DOCKER: http://host.docker.internal:8333)
#        BUCKET=exportaciones  KEY=almacenero  SECRET=almacenero-dev-secreto
